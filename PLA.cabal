cabal-version: 3.0
name: PLA
version: 0.1.0.0
build-type: Simple

common defaults
  ghc-options:
    -Wall
    -O2
    -fobject-code

  default-extensions:
    AllowAmbiguousTypes
    BlockArguments
    DataKinds
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    PartialTypeSignatures
    PolyKinds
    ScopedTypeVariables
    TypeApplications
    TypeOperators

  build-depends:
    base >=4.20 && <4.23,
    containers,

  default-language: Haskell2010

executable EDPL
  import: defaults
  hs-source-dirs: src
  main-is: EDPL.hs
  other-modules: Shared
  ghc-options:
    -main-is
    EDPL

executable EEDPL
  import: defaults
  hs-source-dirs: src
  main-is: EEDPL.hs
  other-modules: Shared
  ghc-options:
    -main-is
    EEDPL

executable PLA
  import: defaults
  hs-source-dirs: src
  main-is: PLA.hs
  other-modules: Shared
  ghc-options:
    -main-is
    PLA

executable PLASafe
  import: defaults
  hs-source-dirs: src
  main-is: PLASafe.hs
  ghc-options:
    -main-is
    PLASafe

test-suite eedpl-tests
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs:
    test
    src

  main-is: EEDPLSpec.hs
  other-modules: EEDPL Shared
  build-depends:
    QuickCheck

executable SEDPL
  import: defaults
  hs-source-dirs: src
  main-is: SEDPL.hs
  other-modules: Shared
  ghc-options:
    -main-is
    SEDPL
