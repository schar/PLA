cabal-version: 3.0
name: PLA
version: 0.1.0.0
build-type: Simple

common defaults
  ghc-options:
    -Wall
    -O2

  build-depends:
    base >=4.20 && <4.23,
    containers,

  default-language: Haskell2010

library
  import: defaults
  hs-source-dirs: src
  exposed-modules:
    Shared
    PLA
    PLASafe
    EDPL
    EEDPL
    SEDPL

executable EDPL
  import: defaults
  hs-source-dirs: app/EDPL
  main-is: Main.hs
  build-depends: PLA

executable EEDPL
  import: defaults
  hs-source-dirs: app/EEDPL
  main-is: Main.hs
  build-depends: PLA

executable PLA
  import: defaults
  hs-source-dirs: app/PLA
  main-is: Main.hs
  build-depends: PLA

executable PLASafe
  import: defaults
  hs-source-dirs: app/PLASafe
  main-is: Main.hs
  build-depends: PLA

executable SEDPL
  import: defaults
  hs-source-dirs: app/SEDPL
  main-is: Main.hs
  build-depends: PLA

test-suite eedpl-tests
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: EEDPLSpec.hs
  build-depends:
    PLA,
    QuickCheck

test-suite examples
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Examples.hs
  build-depends: PLA
